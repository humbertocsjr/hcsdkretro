; DECLARED EXTERNAL FUNCTION: str_len
; DECLARED EXTERNAL FUNCTION: tty_print_char
; DECLARED EXTERNAL FUNCTION: tty_print_str
; FUNCTION: soma
section text
global _soma
_soma:
; RETURN EXPRESSION
  mov ax, [bp+6] ; a
  mov ax, [bp+4] ; b
  add ax, bx
; END RETURN EXPRESSION
  jmp .__END__
  .__END__:
  ret
; END FUNCTION: soma
; FUNCTION: main
section text
global _main
_main:
; EXPRESSION COMMAND
; CALL FUNCTION tty_print_str
section data
  .L0:
    db 79 ; O
    db 105 ; i
    db 101 ; e
    db 101 ; e
    db 101 ; e
    db 101 ; e
    db 0
section text
  mov ax, .L0
  push ax
  call _tty_print_str
; END CALL FUNCTION tty_print_str
  add sp, 2
; END EXPRESSION COMMAND
; EXPRESSION COMMAND
; CALL FUNCTION tty_print_char
; CALL FUNCTION soma
  mov ax, 9
  push ax
  mov ax, 48
  push ax
  call _soma
; END CALL FUNCTION soma
  add sp, 4
  push ax
  call _tty_print_char
; END CALL FUNCTION tty_print_char
  add sp, 2
; END EXPRESSION COMMAND
  .__END__:
  ret
; END FUNCTION: main
