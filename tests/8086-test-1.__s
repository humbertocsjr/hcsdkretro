; GLOBAL VAR d
section data
_d: resb 3
; GLOBAL VAR c
section data
_c: resb 2
; GLOBAL VAR b
section data
_b: resb 256
; GLOBAL VAR a
section data
_a: resb 2
; FUNCTION: soma
section text
_soma:
  .__END__:
  ret
; END FUNCTION: soma
; FUNCTION: main
section text
_main:
  push bp
  mov bp, sp
  sub bp, 4
; IF
  mov ax, 1
  test ax, ax
  je near .L0
; THEN
; EXPRESSION COMMAND
  mov al, [bp+-3] ; a
  mov bl, 3
  cmp al, bl
  mov al, 0
  jl $+4
  dec al
  test al, al
  jne near .L1
  mov al, 1
  .L1:
  mov [bp+-3], al ; a
; END EXPRESSION COMMAND
  .L0:
; END IF
; IF
  mov ax, 1
  test ax, ax
  je near .L2
; THEN
; EXPRESSION COMMAND
  mov al, 1
  mov [bp+-3], al ; a
; END EXPRESSION COMMAND
; ELSE
  jmp .L3
  .L2:
; EXPRESSION COMMAND
  mov al, 2
  mov [bp+-3], al ; a
; END EXPRESSION COMMAND
  .L3:
; END IF
; EXPRESSION COMMAND
  mov al, 0
  mov [bp+-3], al ; a
; END EXPRESSION COMMAND
; UNTIL
  .L4:
  mov al, [bp+-3] ; a
  cbw
  mov bx, 3
  cmp ax, bx
  mov ax, 0
  je $+3
  dec ax
  test ax, ax
  jne near .L5
; DO UNTIL
; EXPRESSION COMMAND
  mov al, [bp+-3] ; a
  mov bl, 1
  add al, bl
  mov [bp+-3], al ; a
; END EXPRESSION COMMAND
  jmp .L4
  .L5:
; END UNTIL
; EXPRESSION COMMAND
  mov al, 0
  mov [bp+-3], al ; a
; END EXPRESSION COMMAND
; WHILE
  .L6:
  mov al, [bp+-3] ; a
  cbw
  mov bx, 3
  cmp ax, bx
  mov ax, 0
  jl $+3
  dec ax
  test ax, ax
  je near .L7
; DO WHILE
; EXPRESSION COMMAND
  mov al, [bp+-3] ; a
  mov bl, 1
  add al, bl
  mov [bp+-3], al ; a
; END EXPRESSION COMMAND
  jmp .L6
  .L7:
; END WHILE
; INJECTED ASSEMBLY COMMAND
  ; 8086
; EXPRESSION COMMAND
  mov al, [bp+-3] ; a
  xor ah, ah
  mov bx, 1
  add ax, bx
  mov bx, [_b]
  add ax, bx
  mov bx, _soma
  add ax, bx
  mov [bp+-2], ax ; ptr
; END EXPRESSION COMMAND
  .__END__:
  mov sp, bp
  pop bp
  ret
; END FUNCTION: main
